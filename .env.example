APP_ENV=local
APP_BASE_URL=http://127.0.0.1:8000

# This application connects to Oracle MySQL Community Server only.
# beaa/api/db.php verifies the server identity after connecting and refuses
# to run against MariaDB, PostgreSQL, SQL Server, or SQLite.
DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=project_demo_db
DB_USER=project_demo_user
DB_PASSWORD=change-me

PHP_SERVER_HOST=127.0.0.1
PHP_SERVER_PORT=8000
